# Authentication and POLICYOPS_BUDGET_* variables are implemented; provider/deployment settings remain proposed.
# A POLICYOPS_BUDGET_* variable that is set must be valid (an empty value is refused); unset keeps the default.
# Authentication does not load .env automatically: export its required values explicitly.
# The API server (python -m policyops.api.serve) reads POLICYOPS_ENV, the authentication values and POLICYOPS_DB_*.
# Never put real credentials in this example.
# One of: local, deployment (test is for the test suite only).
POLICYOPS_ENV=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
POLICYOPS_AGENT_PROVIDER=openai
POLICYOPS_BUDGET_AGENT_MODEL=gpt-6-luna
POLICYOPS_BUDGET_AGENT_EFFORT=low
POLICYOPS_BUDGET_SIMULATOR_MODEL=gpt-6-luna
POLICYOPS_BUDGET_SIMULATOR_EFFORT=low
POLICYOPS_BUDGET_JUDGE_MODEL=claude-haiku-5-5
POLICYOPS_BUDGET_JUDGE_EFFORT=low
POLICYOPS_BUDGET_RERANKER_MODEL=gpt-6-luna
POLICYOPS_BUDGET_RERANKER_EFFORT=low
POLICYOPS_BUDGET_RUN_CALLS=12
POLICYOPS_BUDGET_RUN_USD=0.05
POLICYOPS_BUDGET_SCENARIO_USD=0.20
POLICYOPS_BUDGET_INVOCATION_USD=5
POLICYOPS_BUDGET_STUDY_USD=5
POLICYOPS_COMPARISON_MODEL=claude-haiku-5-5
POLICYOPS_EMBEDDING_MODEL=text-embedding-3-small
POLICYOPS_EMBEDDING_DIMENSIONS=1536
POLICYOPS_RERANK_ENABLED=false
POLICYOPS_MAX_TOOL_CALLS=24
POLICYOPS_PAID_EVALS_ENABLED=false
# Proposed placeholder, read by nothing; the API server never uses it for either runtime role.
POLICYOPS_DATABASE_URL=
# API server runtime logins (roles fixed: policyops_auth_runtime and policyops_app_runtime; separate passwords).
POLICYOPS_DB_HOST=127.0.0.1
POLICYOPS_DB_PORT=5432
POLICYOPS_DB_NAME=
# verify-full (default), verify-ca, require, or disable (loopback IP host only).
POLICYOPS_DB_SSLMODE=verify-full
POLICYOPS_DB_CONNECT_TIMEOUT_SECONDS=5
POLICYOPS_DB_POOL_SIZE=5
POLICYOPS_DB_AUTH_PASSWORD=
POLICYOPS_DB_APP_PASSWORD=
POLICYOPS_PUBLIC_ORIGIN=
POLICYOPS_OIDC_ISSUER=
POLICYOPS_OIDC_CLIENT_ID=
POLICYOPS_OIDC_CLIENT_SECRET=
POLICYOPS_BUSINESS_API_URL=
POLICYOPS_BUSINESS_API_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
