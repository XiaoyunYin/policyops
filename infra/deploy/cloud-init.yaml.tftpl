#cloud-config
# No application credentials, API keys or private SSH key belong in user-data.
package_update: true
packages: [ca-certificates, curl, git, ufw, unattended-upgrades, python3-venv, util-linux]
write_files:
  - path: /etc/ssh/sshd_config.d/00-policyops.conf
    permissions: '0644'
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: '0644'
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  - path: /etc/systemd/journald.conf.d/policyops.conf
    permissions: '0644'
    content: |
      [Journal]
      SystemMaxUse=64M
      RuntimeMaxUse=32M
      MaxRetentionSec=7day
  - path: /usr/local/sbin/policyops-bootstrap
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive
      if ! test -f /swapfile; then
        fallocate -l 2G /swapfile
        chmod 0600 /swapfile
        mkswap /swapfile
      fi
      swapon --show=NAME --noheadings | grep -qx /swapfile || swapon /swapfile
      grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
      install -m 0755 -d /etc/apt/keyrings
      curl --fail --silent --show-error https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
      chmod a+r /etc/apt/keyrings/docker.asc
      echo 'deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable' > /etc/apt/sources.list.d/docker.list
      apt-get update
      # Exact upstream apt versions; coordinator verifies availability before apply (deployment.md).
      apt-get install -y docker-ce=5:29.7.2-1~ubuntu.24.04~noble docker-ce-cli=5:29.7.2-1~ubuntu.24.04~noble containerd.io=2.4.2-4~ubuntu.24.04~noble docker-buildx-plugin=0.36.1-1~ubuntu.24.04~noble docker-compose-plugin=5.3.1-1~ubuntu.24.04~noble
      apt-mark hold docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
      systemctl enable --now docker
      /usr/local/sbin/policyops-firewall
      ufw default deny incoming
      ufw default allow outgoing
      ufw allow from ${admin_cidr} to any port 22 proto tcp
      ufw allow 80/tcp
      ufw allow 443/tcp
      ufw --force enable
      sshd -t
      systemctl reload ssh
      systemctl restart systemd-journald
      install -d -m 0700 /var/lib/policyops /var/lib/policyops/tmp /var/lib/policyops/releases
  - path: /usr/local/sbin/policyops-firewall
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail
      # Docker's forwarding bypasses ufw INPUT. Fence its forwarding chain too.
      # This dedicated host owns DOCKER-USER; discard stale/misordered rules.
      umask 077
      exec 9>/run/policyops-firewall.lock
      flock -w 10 9
      nic=$(ip -4 route show default | awk 'NR==1 {print $5}')
      test -n "$nic"
      iptables -w 10 -F DOCKER-USER
      iptables -w 10 -A DOCKER-USER -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
      iptables -w 10 -A DOCKER-USER -i "$nic" -p tcp -m multiport --dports 80,443 -j ACCEPT
      iptables -w 10 -A DOCKER-USER -i "$nic" -j DROP
      iptables -w 10 -A DOCKER-USER -j RETURN
  - path: /etc/systemd/system/policyops-firewall.service
    permissions: '0644'
    content: |
      [Unit]
      Description=PolicyOps Docker forwarding firewall
      After=docker.service
      Requires=docker.service
      PartOf=docker.service
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/policyops-firewall
      [Install]
      WantedBy=docker.service
runcmd:
  - [/usr/local/sbin/policyops-bootstrap]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, policyops-firewall.service]
