{
  "uid": "policyops-observability",
  "title": "PolicyOps local observability",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "query": "policyops-demo,policyops-api,policyops-worker",
        "current": {
          "text": "policyops-demo",
          "value": "policyops-demo"
        }
      },
      {
        "name": "run_id",
        "type": "textbox",
        "query": "",
        "hide": 2,
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "trace_id",
        "type": "textbox",
        "query": "",
        "hide": 2,
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 12,
      "type": "text",
      "title": "Scripted run",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Run `${run_id}` · [Open trace in Tempo](/explore?schemaVersion=1&panes=%7B%22trace%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22uid%22%3A%22tempo%22%2C%22type%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22${trace_id:percentencode}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-15m%22%2C%22to%22%3A%22now%22%7D%7D%7D&orgId=1)\n\nCounters are lossy, process-local diagnostics. The usage and execution ledgers are authoritative. Metrics are shown over the selected time range."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Provider attempts",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, model, outcome) (last_over_time(policyops_provider_calls_total{job=\"$service\"}[${__range_s}s]))",
          "legendFormat": "{{provider}} · {{model}} · {{outcome}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors by code",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (error_code) (last_over_time(policyops_errors_total{job=\"$service\"}[${__range_s}s]))",
          "legendFormat": "{{error_code}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Input and output tokens",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, model) (last_over_time(policyops_provider_input_tokens_total{job=\"$service\"}[${__range_s}s]))",
          "legendFormat": "Input · {{provider}} · {{model}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, model) (last_over_time(policyops_provider_output_tokens_total{job=\"$service\"}[${__range_s}s]))",
          "legendFormat": "Output · {{provider}} · {{model}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fixture usage at configured prices",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 8
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, model) (last_over_time(policyops_provider_cost_usd_USD_total{job=\"$service\"}[${__range_s}s]))",
          "legendFormat": "{{provider}} · {{model}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Mean provider dispatch duration",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
