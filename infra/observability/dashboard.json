      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (provider, model) (last_over_time(policyops_provider_dispatch_duration_seconds_sum{job=\"$service\"}[${__range_s}s])) / sum by (provider, model) (last_over_time(policyops_provider_dispatch_duration_seconds_count{job=\"$service\"}[${__range_s}s]))",
          "legendFormat": "{{provider}} · {{model}}",
