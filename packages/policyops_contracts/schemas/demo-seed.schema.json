      "title": "Label",
      "type": "string"
    },
    "seed_id": {
      "pattern": "^retail-demo-\\d{1,4}$",
      "title": "Seed Id",
      "type": "string"
    },
    "upstream_task_id": {
      "pattern": "^\\d{1,4}$",
      "title": "Upstream Task Id",
      "type": "string"
    }
  },
  "required": [
    "seed_id",
    "label",
    "domain",
    "upstream_task_id",
    "kind",
