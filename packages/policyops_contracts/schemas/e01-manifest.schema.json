    "Envelope": {
      "additionalProperties": false,
      "description": "One common outer per-slot ledger ceiling for a group of comparable arms (reservation maxima, not spend). A\nprovider envelope's USD cap is positive (ledger caps require it); a no-provider slot has no envelope at all.",
      "properties": {
        "cap_calls": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Cap Calls",
          "type": "integer"
        },
        "cap_usd": {
          "pattern": "^(0|[1-9][0-9]{0,6})(\\.[0-9]{1,12})?$",
          "title": "Cap Usd",
          "type": "string"
        },
        "chat_calls": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Chat Calls",
          "type": "integer"
        },
        "embedding_batches": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Embedding Batches",
          "type": "integer"
        },
        "group": {
          "enum": [
            "banking_insitu",
