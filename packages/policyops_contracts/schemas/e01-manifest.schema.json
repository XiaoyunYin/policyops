        "max_output_tokens_per_chat_call",
        "max_input_tokens_per_embedding_batch"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "RerankConfig": {
      "additionalProperties": false,
      "description": "The optional rerank stage (T14): one bounded structured request ordering the first `documents` fused\ndocuments. `seconds` is the stage's own sub-deadline length; `max_output_tokens` is the request's output limit\n(at most the reranker actor's maximum, checked before any work).",
      "properties": {
        "documents": {
          "default": 20,
          "maximum": 20,
          "minimum": 2,
          "title": "Documents",
          "type": "integer"
        },
        "excerpt_bytes": {
          "default": 500,
          "maximum": 1000,
          "minimum": 64,
          "title": "Excerpt Bytes",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 512,
          "maximum": 1024,
          "minimum": 64,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "policy": {
          "default": "baseline_fallback",
          "enum": [
            "baseline_fallback",
            "refuse"
          ],
          "title": "Policy",
          "type": "string"
        },
        "prompt": {
          "const": "policyops.rerank-prompt/v1",
          "default": "policyops.rerank-prompt/v1",
          "title": "Prompt",
          "type": "string"
        },
        "seconds": {
          "default": 10,
          "maximum": 30,
          "minimum": 1,
          "title": "Seconds",
          "type": "integer"
        },
        "v": {
          "const": "policyops.rerank-config/v1",
          "default": "policyops.rerank-config/v1",
          "title": "V",
          "type": "string"
        }
      },
      "title": "RerankConfig",
      "type": "object"
    },
    "RetrievalConfig": {
      "additionalProperties": false,
      "description": "Versioned, caller-supplied configuration. Every field is in `sha256()` and therefore in the step's request\nfingerprint and trace. `full_policy_max_chunks` is the explicit baseline exception to `max_chunks`; both modes\nshare `max_evidence_tokens` (the whole formatted, concatenated evidence string counted with cl100k).\n\n`rerank` (T14) is omitted from the serialization, and therefore from `sha256()`, when it is None: every T13\nconfiguration keeps its digest and request fingerprint.",
      "properties": {
        "branch_documents": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Branch Documents",
          "type": "integer"
        },
        "chunks_per_document": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "title": "Chunks Per Document",
          "type": "integer"
        },
        "dense_policy": {
          "default": "lexical_fallback",
          "enum": [
            "lexical_fallback",
            "refuse"
          ],
          "title": "Dense Policy",
          "type": "string"
        },
        "embedding_dimensions": {
          "const": 1536,
          "default": 1536,
          "title": "Embedding Dimensions",
          "type": "integer"
        },
        "embedding_model": {
          "const": "text-embedding-3-small",
          "default": "text-embedding-3-small",
          "title": "Embedding Model",
          "type": "string"
        },
        "evidence_format": {
          "const": "policyops.evidence-format/v1",
          "default": "policyops.evidence-format/v1",
          "title": "Evidence Format",
          "type": "string"
        },
        "fts_config": {
          "const": "english",
          "default": "english",
          "title": "Fts Config",
          "type": "string"
        },
        "fts_rank": {
          "const": "ts_rank_cd/32",
          "default": "ts_rank_cd/32",
          "title": "Fts Rank",
          "type": "string"
        },
        "full_policy_max_chunks": {
          "default": 16,
          "maximum": 16,
          "minimum": 1,
          "title": "Full Policy Max Chunks",
          "type": "integer"
        },
        "max_admission_attempts": {
          "default": 64,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Admission Attempts",
          "type": "integer"
        },
        "max_chunks": {
          "default": 6,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Chunks",
          "type": "integer"
        },
        "max_evidence_tokens": {
          "default": 4096,
          "maximum": 16000,
          "minimum": 1,
          "title": "Max Evidence Tokens",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "full_policy",
            "lexical",
            "dense",
            "hybrid"
          ],
          "title": "Mode",
          "type": "string"
        },
        "rerank": {
          "anyOf": [
            {
              "$ref": "#/$defs/RerankConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
