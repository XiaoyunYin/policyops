        "rrf_k": {
          "default": 60,
          "maximum": 1000,
          "minimum": 1,
          "title": "Rrf K",
          "type": "integer"
        },
        "v": {
          "const": "policyops.retrieval-config/v2",
          "default": "policyops.retrieval-config/v2",
          "title": "V",
          "type": "string"
        }
