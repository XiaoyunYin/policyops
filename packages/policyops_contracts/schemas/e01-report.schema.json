    "Interval": {
      "additionalProperties": false,
      "description": "Paired task-cluster bootstrap: B resamples of clusters with replacement (trials stay inside their task), each\ndraw the exact mean difference; the bounds are the type-7 (linear interpolation) empirical quantiles at 2.5% and\n97.5% of the sorted draws (h = (B - 1) p). Computed with exact fractions; rendered ROUND_HALF_EVEN to 12 places.",
      "properties": {
        "clusters": {
          "enum": [
            "task",
            "group"
          ],
          "title": "Clusters",
          "type": "string"
        },
        "estimate": {
          "pattern": "^-?(0|[1-9][0-9]{0,6})(\\.[0-9]{1,12})?$",
          "title": "Estimate",
          "type": "string"
        },
        "lower": {
          "pattern": "^-?(0|[1-9][0-9]{0,6})(\\.[0-9]{1,12})?$",
          "title": "Lower",
          "type": "string"
        },
        "resamples": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Resamples",
          "type": "integer"
        },
        "upper": {
          "pattern": "^-?(0|[1-9][0-9]{0,6})(\\.[0-9]{1,12})?$",
          "title": "Upper",
          "type": "string"
        }
      },
      "required": [
        "estimate",
        "lower",
        "upper",
        "resamples",
        "clusters"
      ],
      "title": "Interval",
      "type": "object"
    },
