  "additionalProperties": false,
  "description": "One slot's outcome. Never carries labels, instructions, reference actions or query text.\n\n`calls`, `spent_usd` and `held_usd` are None (unknown) unless the slot's own ledger scope supplied them: a stored\ntrace (or a winning trace replayed by a paid losing writer) is never per-invocation cost authority, so an export\nnever invents zero work or infers study cost from traces.",
  "properties": {
    "arm_id": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "R0",
        "R1"
      ],
      "title": "Arm Id",
      "type": "string"
    },
    "calls": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActorCalls"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "held_usd": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]{0,6})(\\.[0-9]{1,12})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Held Usd"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "phase": {
      "enum": [
        "acquisition",
        "replay",
        "confirmation",
        "retail_control"
      ],
      "title": "Phase",
      "type": "string"
    },
    "slot_id": {
      "format": "uuid",
      "title": "Slot Id",
      "type": "string"
    },
    "spent_usd": {
      "anyOf": [
        {
          "pattern": "^(0|[1-9][0-9]{0,6})(\\.[0-9]{1,12})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spent Usd"
    },
    "status": {
      "enum": [
        "completed",
        "budget_stop",
        "interrupted",
        "infra_error",
        "simulator_error",
        "retrieval_error"
      ],
      "title": "Status",
      "type": "string"
    },
    "steps": {
