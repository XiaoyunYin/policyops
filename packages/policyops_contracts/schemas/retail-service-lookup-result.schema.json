{
  "$comment": "policyops_contracts 0.3.0; generated, do not edit",
  "$defs": {
    "Address": {
      "additionalProperties": false,
      "properties": {
        "address1": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Address1",
          "type": "string"
        },
        "address2": {
          "maxLength": 100,
          "minLength": 0,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Address2",
          "type": "string"
        },
        "city": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "City",
          "type": "string"
        },
        "country": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Country",
          "type": "string"
        },
        "state": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "State",
          "type": "string"
        },
        "zip": {
          "pattern": "^\\d{5}$",
          "title": "Zip",
          "type": "string"
        }
      },
      "required": [
        "address1",
        "address2",
        "city",
        "state",
        "country",
        "zip"
      ],
      "title": "Address",
      "type": "object"
    },
    "CancelEffect": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "cancel_pending_order",
          "default": "cancel_pending_order",
          "title": "Kind",
          "type": "string"
        },
        "order_id": {
          "pattern": "^#W\\d{7}$",
          "title": "Order Id",
          "type": "string"
        },
        "reason": {
          "enum": [
            "no longer needed",
            "ordered by mistake"
          ],
          "title": "Reason",
          "type": "string"
        },
        "refunds": {
          "items": {
            "$ref": "#/$defs/RefundLine"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Refunds",
          "type": "array"
        },
        "status_after": {
          "const": "cancelled",
          "default": "cancelled",
          "title": "Status After",
          "type": "string"
        },
        "status_before": {
          "const": "pending",
          "default": "pending",
          "title": "Status Before",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "reason",
        "refunds"
      ],
      "title": "CancelEffect",
      "type": "object"
    },
    "ItemChangeLine": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "pattern": "^\\d{10}$",
          "title": "Item Id",
          "type": "string"
        },
        "new_item_id": {
          "pattern": "^\\d{10}$",
          "title": "New Item Id",
          "type": "string"
        },
        "price_after": {
          "$ref": "#/$defs/Money"
        },
        "price_before": {
          "$ref": "#/$defs/Money"
        },
        "product_id": {
          "pattern": "^\\d{10}$",
          "title": "Product Id",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "new_item_id",
        "product_id",
        "price_before",
        "price_after"
      ],
      "title": "ItemChangeLine",
      "type": "object"
    },
    "ItemsEffect": {
      "additionalProperties": false,
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/ItemChangeLine"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Changes",
          "type": "array"
        },
        "kind": {
          "enum": [
            "modify_pending_order_items",
            "exchange_delivered_order_items"
          ],
          "title": "Kind",
          "type": "string"
        },
        "one_time_action": {
          "const": true,
          "default": true,
          "title": "One Time Action",
          "type": "boolean"
        },
        "order_id": {
          "pattern": "^#W\\d{7}$",
          "title": "Order Id",
          "type": "string"
        },
        "payment_method_id": {
          "pattern": "^(?:credit_card|paypal|gift_card)_\\d{7}$",
          "title": "Payment Method Id",
          "type": "string"
        },
        "price_difference": {
          "$ref": "#/$defs/Money"
        },
        "status_after": {
          "enum": [
            "pending (item modified)",
            "exchange requested"
          ],
          "title": "Status After",
          "type": "string"
        },
        "status_before": {
          "enum": [
            "pending",
            "delivered"
          ],
          "title": "Status Before",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "order_id",
        "changes",
        "price_difference",
        "payment_method_id",
        "status_before",
        "status_after"
      ],
      "title": "ItemsEffect",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "maximum": 1000000000000,
          "minimum": -1000000000000,
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount_minor"
      ],
      "title": "Money",
      "type": "object"
    },
    "OperationResult": {
      "additionalProperties": false,
      "description": "A stored outcome. Only `committed` carries a receipt; every other outcome changed nothing.",
      "properties": {
        "operation_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Operation Id",
          "type": "string"
        },
        "operation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Operation Sha256",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "committed",
            "upstream_rejected",
            "effect_mismatch",
            "money_unrepresentable",
            "version_conflict",
            "fenced"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Receipt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "replayed": {
          "title": "Replayed",
          "type": "boolean"
        }
      },
      "required": [
        "operation_id",
        "operation_sha256",
        "outcome",
        "replayed"
      ],
      "title": "OperationResult",
      "type": "object"
    },
    "OrderAddressEffect": {
      "additionalProperties": false,
      "properties": {
        "address_after": {
          "$ref": "#/$defs/Address"
        },
        "address_before": {
          "$ref": "#/$defs/Address"
        },
        "kind": {
          "const": "modify_pending_order_address",
          "default": "modify_pending_order_address",
          "title": "Kind",
          "type": "string"
        },
        "order_id": {
          "pattern": "^#W\\d{7}$",
          "title": "Order Id",
          "type": "string"
        },
        "status_after": {
          "const": "pending",
          "default": "pending",
          "title": "Status After",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "address_before",
        "address_after"
      ],
      "title": "OrderAddressEffect",
      "type": "object"
    },
    "PaymentChangeEffect": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "from_payment_method_id": {
          "pattern": "^(?:credit_card|paypal|gift_card)_\\d{7}$",
          "title": "From Payment Method Id",
          "type": "string"
        },
        "kind": {
          "const": "modify_pending_order_payment",
          "default": "modify_pending_order_payment",
          "title": "Kind",
          "type": "string"
        },
        "order_id": {
          "pattern": "^#W\\d{7}$",
          "title": "Order Id",
          "type": "string"
        },
        "refund_timing": {
          "enum": [
            "immediately",
            "5 to 7 business days"
          ],
          "title": "Refund Timing",
          "type": "string"
        },
        "status_after": {
          "const": "pending",
          "default": "pending",
          "title": "Status After",
          "type": "string"
        },
        "to_payment_method_id": {
          "pattern": "^(?:credit_card|paypal|gift_card)_\\d{7}$",
          "title": "To Payment Method Id",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "from_payment_method_id",
        "to_payment_method_id",
        "amount",
        "refund_timing"
      ],
      "title": "PaymentChangeEffect",
      "type": "object"
    },
    "Receipt": {
      "additionalProperties": false,
      "description": "The immutable success record of one committed mutation.",
      "properties": {
        "actual_effect": {
          "discriminator": {
            "mapping": {
              "cancel_pending_order": "#/$defs/CancelEffect",
              "exchange_delivered_order_items": "#/$defs/ItemsEffect",
              "modify_pending_order_address": "#/$defs/OrderAddressEffect",
              "modify_pending_order_items": "#/$defs/ItemsEffect",
              "modify_pending_order_payment": "#/$defs/PaymentChangeEffect",
              "modify_user_address": "#/$defs/UserAddressEffect",
              "return_delivered_order_items": "#/$defs/ReturnEffect"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CancelEffect"
            },
            {
              "$ref": "#/$defs/OrderAddressEffect"
            },
            {
              "$ref": "#/$defs/PaymentChangeEffect"
            },
            {
              "$ref": "#/$defs/ItemsEffect"
            },
            {
              "$ref": "#/$defs/ReturnEffect"
            },
            {
              "$ref": "#/$defs/UserAddressEffect"
            }
          ],
          "title": "Actual Effect"
        },
        "case_version_after": {
          "maximum": 9007199254740992,
          "minimum": 1,
          "title": "Case Version After",
          "type": "integer"
        },
        "case_version_before": {
          "maximum": 9007199254740992,
          "minimum": 1,
          "title": "Case Version Before",
          "type": "integer"
        },
        "committed_at": {
          "format": "date-time",
          "title": "Committed At",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Operation Id",
          "type": "string"
        },
        "operation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Operation Sha256",
          "type": "string"
        },
        "resource_versions_after": {
          "items": {
            "$ref": "#/$defs/ResourceVersion"
          },
          "maxItems": 64,
          "title": "Resource Versions After",
          "type": "array"
        },
        "state_sha256_after": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Sha256 After",
          "type": "string"
        },
        "tool": {
          "enum": [
            "cancel_pending_order",
            "modify_pending_order_address",
            "modify_pending_order_payment",
            "modify_pending_order_items",
            "return_delivered_order_items",
            "exchange_delivered_order_items",
            "modify_user_address"
          ],
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "operation_sha256",
        "tool",
        "actual_effect",
        "case_version_before",
        "case_version_after",
        "resource_versions_after",
        "state_sha256_after",
        "committed_at"
      ],
      "title": "Receipt",
      "type": "object"
    },
    "RefundLine": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "payment_method_id": {
          "pattern": "^(?:credit_card|paypal|gift_card)_\\d{7}$",
          "title": "Payment Method Id",
          "type": "string"
        },
        "timing": {
          "enum": [
            "immediately",
            "5 to 7 business days"
          ],
          "title": "Timing",
          "type": "string"
        }
      },
      "required": [
        "payment_method_id",
        "amount",
        "timing"
      ],
      "title": "RefundLine",
      "type": "object"
    },
    "ResourceVersion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "user",
            "order",
            "product"
          ],
          "title": "Kind",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "version": {
          "maximum": 9007199254740992,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "resource_id",
        "version"
      ],
      "title": "ResourceVersion",
      "type": "object"
    },
    "ReturnEffect": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ReturnLine"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "const": "return_delivered_order_items",
          "default": "return_delivered_order_items",
          "title": "Kind",
          "type": "string"
        },
        "order_id": {
          "pattern": "^#W\\d{7}$",
          "title": "Order Id",
          "type": "string"
        },
        "refund_payment_method_id": {
          "pattern": "^(?:credit_card|paypal|gift_card)_\\d{7}$",
          "title": "Refund Payment Method Id",
          "type": "string"
        },
        "returned_items_price_total": {
          "$ref": "#/$defs/Money"
        },
        "status_after": {
          "const": "return requested",
          "default": "return requested",
          "title": "Status After",
          "type": "string"
        },
        "status_before": {
          "const": "delivered",
          "default": "delivered",
          "title": "Status Before",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "items",
        "returned_items_price_total",
        "refund_payment_method_id"
      ],
      "title": "ReturnEffect",
      "type": "object"
    },
    "ReturnLine": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "pattern": "^\\d{10}$",
          "title": "Item Id",
          "type": "string"
        },
        "price": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "item_id",
        "price"
      ],
      "title": "ReturnLine",
      "type": "object"
    },
    "UserAddressEffect": {
      "additionalProperties": false,
      "properties": {
        "address_after": {
          "$ref": "#/$defs/Address"
        },
        "address_before": {
          "$ref": "#/$defs/Address"
        },
        "kind": {
          "const": "modify_user_address",
          "default": "modify_user_address",
          "title": "Kind",
          "type": "string"
        },
        "user_id": {
          "maxLength": 64,
          "pattern": "^[a-z]+(?:_[a-z]+)*_\\d{1,6}$",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "address_before",
        "address_after"
      ],
      "title": "UserAddressEffect",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`unknown` is not `not executed`: only a fence makes absence definitive.",
  "properties": {
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "state": {
      "enum": [
        "found",
        "unknown"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "state"
  ],
  "title": "LookupResult",
  "type": "object"
}
