          "$ref": "#/$defs/UserDetail"
        }
      },
      "required": [
        "user"
      ],
      "title": "UserOutput",
      "type": "object"
    },
    "VariantDetail": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "item_id": {
          "pattern": "^\\d{10}$",
          "title": "Item Id",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/OptionValue"
          },
          "maxItems": 16,
          "title": "Options",
          "type": "array"
        },
        "price": {
          "$ref": "#/$defs/Money"
        },
        "product_id": {
          "pattern": "^\\d{10}$",
          "title": "Product Id",
          "type": "string"
        },
        "product_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Product Name",
          "type": "string"
        },
        "product_version": {
          "maximum": 9007199254740992,
          "minimum": 1,
          "title": "Product Version",
          "type": "integer"
        }
      },
      "required": [
        "product_id",
        "product_name",
        "item_id",
        "available",
        "price",
        "options",
        "product_version"
      ],
      "title": "VariantDetail",
      "type": "object"
    },
    "VariantOutput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "variant",
          "default": "variant",
          "title": "Kind",
          "type": "string"
        },
        "variant": {
          "$ref": "#/$defs/VariantDetail"
        }
      },
      "required": [
        "variant"
      ],
      "title": "VariantOutput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_version": {
      "maximum": 9007199254740992,
      "minimum": 1,
      "title": "Case Version",
      "type": "integer"
    },
    "output": {
      "discriminator": {
        "mapping": {
          "calculation": "#/$defs/CalculationOutput",
          "order": "#/$defs/OrderOutput",
          "product": "#/$defs/ProductOutput",
          "product_types": "#/$defs/ProductTypesOutput",
          "user": "#/$defs/UserOutput",
          "user_id": "#/$defs/UserIdOutput",
          "variant": "#/$defs/VariantOutput"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/UserIdOutput"
        },
        {
          "$ref": "#/$defs/UserOutput"
        },
        {
          "$ref": "#/$defs/OrderOutput"
        },
        {
          "$ref": "#/$defs/ProductOutput"
        },
        {
          "$ref": "#/$defs/VariantOutput"
        },
        {
          "$ref": "#/$defs/ProductTypesOutput"
        },
        {
          "$ref": "#/$defs/CalculationOutput"
        }
      ],
      "title": "Output"
    },
    "resource_versions": {
      "items": {
        "$ref": "#/$defs/ResourceVersion"
      },
      "maxItems": 64,
      "title": "Resource Versions",
      "type": "array"
    }
  },
  "required": [
    "output",
    "case_version",
    "resource_versions"
  ],
  "title": "ReadResult",
  "type": "object"
}
