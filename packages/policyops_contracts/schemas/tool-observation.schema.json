    "UserDetail": {
      "additionalProperties": false,
      "description": "The case's own customer: name, contact, address, methods and *their* order IDs only.",
      "properties": {
        "address": {
          "$ref": "#/$defs/Address"
        },
        "email": {
          "maxLength": 254,
          "pattern": "^[^@\\s]{1,64}@[^@\\s]{1,189}\\.[A-Za-z]{2,}$",
          "title": "Email",
          "type": "string"
        },
        "first_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "First Name",
          "type": "string"
        },
        "last_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Last Name",
          "type": "string"
