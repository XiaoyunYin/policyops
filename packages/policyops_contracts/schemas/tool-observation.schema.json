        "items": {
          "items": {
            "$ref": "#/$defs/OrderItemDetail"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "order_id": {
          "pattern": "^#W\\d{7}$",
          "title": "Order Id",
          "type": "string"
        },
        "payment_history": {
          "items": {
            "$ref": "#/$defs/PaymentRecord"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Payment History",
          "type": "array"
        },
        "return_request": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReturnRequestDetail"
            },
            {
              "type": "null"
            }
          ],
          "default": null
