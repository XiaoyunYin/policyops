          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "outcome"
      ],
      "title": "LookupObservation",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount_minor": {
          "maximum": 1000000000000,
          "minimum": -1000000000000,
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount_minor"
      ],
      "title": "Money",
      "type": "object"
    },
    "OptionValue": {
      "additionalProperties": false,
      "description": "One variant option (for example `color` = `blue`); a variant's options are sorted by name.",
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "OptionValue",
      "type": "object"
    },
    "OrderDetail": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/Address"
        },
        "cancel_reason": {
          "anyOf": [
            {
              "enum": [
                "no longer needed",
                "ordered by mistake"
