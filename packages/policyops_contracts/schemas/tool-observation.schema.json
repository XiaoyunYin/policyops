          "type": "string"
        },
        "user_id": {
          "maxLength": 64,
          "pattern": "^[a-z]+(?:_[a-z]+)*_\\d{1,6}$",
          "title": "User Id",
          "type": "string"
        },
        "version": {
          "maximum": 9007199254740992,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "order_id",
        "user_id",
        "version",
        "status",
        "address",
        "items",
        "fulfillments",
        "payment_history"
