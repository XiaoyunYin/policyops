{
  "$comment": "policyops_contracts 0.3.0; generated, do not edit",
  "$defs": {
    "Address": {
      "additionalProperties": false,
      "properties": {
        "address1": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Address1",
          "type": "string"
        },
        "address2": {
          "maxLength": 100,
          "minLength": 0,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Address2",
          "type": "string"
        },
        "city": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "City",
          "type": "string"
        },
        "country": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Country",
          "type": "string"
        },
        "state": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "State",
          "type": "string"
        },
        "zip": {
          "pattern": "^\\d{5}$",
          "title": "Zip",
          "type": "string"
        }
      },
      "required": [
        "address1",
        "address2",
        "city",
        "state",
        "country",
        "zip"
      ],
      "title": "Address",
      "type": "object"
    },
    "CalculationOutput": {
      "additionalProperties": false,
      "description": "Upstream's rounded float rendering. A calculator result is never exact-money evidence.",
      "properties": {
        "kind": {
          "const": "calculation",
          "default": "calculation",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maxLength": 64,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "CalculationOutput",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "invalid_input",
        "unauthenticated",
        "forbidden",
        "not_found",
        "conflict",
        "stale_version",
        "context_changed",
        "expired",
        "customer_not_authenticated",
        "customer_mismatch",
        "policy_denied",
        "policy_unsupported",
        "consent_required",
        "consent_ambiguous",
        "approval_required",
        "separation_of_duties",
        "protocol_violation",
        "upstream_money_precision",
        "rate_limited",
        "unavailable",
        "internal"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ExchangeRequestDetail": {
      "additionalProperties": false,
      "description": "A *recorded* exchange request: upstream changes no item, payment or balance until it is processed.",
      "properties": {
        "item_ids": {
          "items": {
            "pattern": "^\\d{10}$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Item Ids",
          "type": "array"
        },
        "new_item_ids": {
          "items": {
            "pattern": "^\\d{10}$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "New Item Ids",
          "type": "array"
        },
        "payment_method_id": {
          "pattern": "^(?:credit_card|paypal|gift_card)_\\d{7}$",
          "title": "Payment Method Id",
          "type": "string"
        },
        "price_difference": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "item_ids",
        "new_item_ids",
        "payment_method_id",
        "price_difference"
      ],
      "title": "ExchangeRequestDetail",
      "type": "object"
    },
    "FulfillmentDetail": {
      "additionalProperties": false,
      "properties": {
        "item_ids": {
          "items": {
            "pattern": "^\\d{10}$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Item Ids",
          "type": "array"
        },
        "tracking_ids": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Tracking Ids",
          "type": "array"
        }
      },
      "required": [
        "tracking_ids",
        "item_ids"
      ],
      "title": "FulfillmentDetail",
      "type": "object"
    },
    "HandoffObservation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "handoff",
          "default": "handoff",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "const": "YOU ARE BEING TRANSFERRED TO A HUMAN AGENT. PLEASE HOLD ON.",
          "default": "YOU ARE BEING TRANSFERRED TO A HUMAN AGENT. PLEASE HOLD ON.",
          "title": "Message",
          "type": "string"
        }
      },
      "title": "HandoffObservation",
      "type": "object"
    },
    "LookupObservation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "lookup",
          "default": "lookup",
          "title": "Kind",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "authenticated",
            "not_found"
