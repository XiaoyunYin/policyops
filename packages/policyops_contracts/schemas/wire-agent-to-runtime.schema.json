      ],
      "title": "PolicyContext",
      "type": "object"
    },
    "ToolCatalog": {
      "additionalProperties": false,
      "description": "`retail`: exactly the runtime's typed retail tools. `descriptor`: externally supplied descriptors, validated\nagainst their own schema and executed only by the injected tool port. `knowledge_tool` adds the fixed read-only\n`search_policy` tool, which counts toward every catalog limit; its name is reserved.",
      "properties": {
        "knowledge_tool": {
          "default": false,
          "title": "Knowledge Tool",
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "retail",
            "descriptor"
